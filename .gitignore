# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 삭제 대기 폴더 (사용자가 직접 확인 후 삭제)
/trash-can/

# 로컬 도구 설정 (개발 서버 실행 설정 등)
/.claude/

# 작업 기록 도구 폴더 (PC 사용자 경로가 들어 있어 커밋하지 않는다)
/.bkit/

# typescript
*.tsbuildinfo
next-env.d.ts
